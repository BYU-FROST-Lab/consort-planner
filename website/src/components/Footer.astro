---
// The FROST Lab site's footer, with the BYU monogram beside the lab logo as in
// the lab site's header. The monogram's viewBox is cropped to the letters, so
// its left edge lines up with the text below. The logos are loaded as images, not inlined: both SVGs
// define a `.cls-1` style, and inlining them in one document would let one
// recolor the other.
import byu from '../assets/logos/byu.svg';
import frost from '../assets/logos/frost-lab.svg';
import { lab, repoUrl } from '../config';
import { footerColumns, socialLinks } from '../data/footer';
import Icon from './Icon.astro';

const muted = 'text-ink-3 transition-colors hover:text-ink hover:underline';
---

<footer class="border-t border-line bg-page">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-12 gap-4 gap-y-8 py-8 sm:gap-x-6 md:py-12">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-3 flex items-center gap-3">
          <a href="https://www.byu.edu/">
            <img src={byu.src} width={byu.width} height={byu.height} alt="Brigham Young University" class="h-5 w-auto" />
          </a>
          <span class="h-10 border-l border-line" aria-hidden="true"></span>
          <a href={lab.url}>
            <img src={frost.src} width={frost.width} height={frost.height} alt={lab.name} class="h-12 w-auto" />
          </a>
        </div>
        <p class="text-sm">
          <a href="https://www.byu.edu/" class={muted}>Brigham Young University</a>
        </p>
      </div>
      {
        footerColumns.map((column) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <p class="mb-2 font-medium text-ink">{column.title}</p>
            <ul class="text-sm">
              {column.links.map((l) => (
                <li class="mb-2">
                  <a href={l.href} class={muted}>
                    {l.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="py-6 md:flex md:items-center md:justify-between md:py-8">
      <ul class="mb-4 -ml-2 flex md:order-1 md:mb-0 md:ml-4">
        {
          socialLinks.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label} class="inline-flex rounded-lg p-2.5 text-ink-3 transition-colors hover:bg-tint hover:text-ink">
                <Icon name={s.icon} class="size-5" />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mr-4 text-xs text-ink-3">
        Page source in <a href={`${repoUrl}/tree/main/website`} class="text-accent underline">website/</a> · Layout
        adapted from the{' '}
        <a href="https://github.com/eliahuhorwitz/Academic-project-page-template" class="text-accent underline">Academic Project Page Template</a>
      </p>
    </div>
  </div>
</footer>
