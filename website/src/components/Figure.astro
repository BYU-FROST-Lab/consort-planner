---
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Bold lead-in to the caption, e.g. "Fig. 3." */
  label?: string;
  class?: string;
}

// The figures are served as committed: lossless WebP at about 2x their
// on-page width. Re-encoding them as lossy WebP would blur the plot text and,
// for flat-color plots, make the files larger, not smaller.
const { src, alt, label, class: className } = Astro.props;
const hasCaption = Astro.slots.has('default');
---

<figure class={className}>
  <div class="overflow-hidden rounded-xl border border-line bg-white p-2 sm:p-3">
    <img src={src.src} width={src.width} height={src.height} alt={alt} loading="lazy" decoding="async" class="h-auto w-full" />
  </div>
  {
    hasCaption && (
      <figcaption class="mt-3 text-[0.925rem] leading-relaxed text-ink-3">
        {label && <span class="font-semibold text-ink-2">{label} </span>}
        <slot />
      </figcaption>
    )
  }
</figure>
