---
interface Props {
  /** YouTube video ID. */
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div class="relative aspect-video overflow-hidden rounded-xl bg-abyss shadow-lg">
  <iframe
    data-video
    src={`https://www.youtube-nocookie.com/embed/${id}?rel=0`}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
    class="size-full"
  />
</div>

<script>
  // Links marked data-video-seek="<seconds>" start the embedded video there
  // instead of leaving for YouTube.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-video-seek]');
    const frame = document.querySelector<HTMLIFrameElement>('iframe[data-video]');
    if (!link || !frame) return;
    e.preventDefault();
    const url = new URL(frame.src);
    url.searchParams.set('start', link.dataset.videoSeek ?? '0');
    url.searchParams.set('autoplay', '1');
    frame.src = url.toString();
    frame.closest('section')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>
